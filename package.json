{
  "name": "ducky-land-integrated",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "test": "node scripts/globe-svg/check.mjs && node --test qa/*.test.mjs",
    "build": "node scripts/globe-svg/check.mjs && vite build",
    "dev": "vite",
    "preview": "vite preview",
    "globe:assets": "node scripts/globe-perf/refresh.mjs",
    "bog:dev": "vite --config scripts/bog-environment/vite.config.mjs --configLoader native --port 8897 --strictPort",
    "bog:build": "vite build --config scripts/bog-environment/vite.config.mjs --configLoader native",
    "bog:capture": "node scripts/bog-environment/capture.mjs",
    "globe:check": "node scripts/globe-svg/check.mjs"
  },
  "dependencies": {
    "@rive-app/webgl2-advanced": "^2.46.0",
    "pixi.js": "^8.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.13",
    "@vitejs/plugin-react": "^6.2.1",
    "@xmldom/xmldom": "0.8.15",
    "esbuild": "0.28.2",
    "jsdom": "^30.1.3",
    "miniflare": "5.20261102.0-beta",
    "sharp": "0.35.5",
    "three": "^0.187.0",
    "vite": "^8.3.5"
  }
}
