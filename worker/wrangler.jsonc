{
  "name": "ducky-land-room",
  "main": "cloudflare.js",
  "compatibility_date": "2026-11-02",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {"SENTRY_ENVIRONMENT": "shared"},
  "version_metadata": {"binding": "CF_VERSION_METADATA"},
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true,
      "destinations": ["sentry-room-logs"]
    }
  },
  "limits": {"cpu_ms": 60000},
  "durable_objects": {"bindings": [{"name": "ISLAND", "class_name": "IslandRoom"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["IslandRoom"]}]
}
