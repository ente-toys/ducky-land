{
  "name": "ducky-land-room",
  "main": "cloudflare.js",
  "compatibility_date": "2026-11-02",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {"SENTRY_ENVIRONMENT": "shared"},
  "version_metadata": {"binding": "CF_VERSION_METADATA"},
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true,
      "destinations": ["sentry-room-logs"]
    },
    "traces": {
      "enabled": true,
      "destinations": ["sentry-room-traces"],
      "head_sampling_rate": 0.05
    }
  },
  "limits": {"cpu_ms": 60000},
  "durable_objects": {"bindings": [{"name": "ISLAND", "class_name": "IslandRoom"},
    {"name": "ISLAND_SIM", "class_name": "IslandSimulation"},
    {"name": "SEA_SIM", "class_name": "SeaSimulation"},
    {"name": "WORLD_PRESENCE", "class_name": "WorldPresence"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["IslandRoom"]},
    {"tag":"v2-simulations","new_sqlite_classes":["IslandSimulation","SeaSimulation","WorldPresence"]}]
}
